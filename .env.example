# Bootstrap/development values only. Production integration values will move to the
# developer portal (Phase 9). Never commit a real .env.

# --- Meta Messenger ---
META_GRAPH_API_VERSION=v21.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=change-me
META_APP_ID=
# Pause the bot for a customer when staff reply by hand from the Page inbox.
PAUSE_BOT_ON_STAFF_REPLY=true

# --- OpenRouter (Phase 5) ---
OPENROUTER_API_KEY=
AI_MODEL=
AI_FALLBACK_MODEL=
# Room for the reply (and any thinking the model does first). Too low and replies come back empty.
AI_MAX_TOKENS=1500
MAX_TOOL_ROUNDS=6

# --- Twilio (Phase 6) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Comma-separated E.164 list (owner has two phones). Every number receives order SMS and may send commands.
OWNER_PHONE_NUMBERS=
SMS_STATUS_CALLBACK_URL=https://orders.example.com/webhooks/sms/status

# --- Store / business rules (PLACEHOLDERS until the owner confirms) ---
STORE_TIMEZONE=America/Chicago
STORE_LOCATION=watson
# Sales tax in basis points (825 = 8.25%). 0 disables tax; summaries then say "before tax".
TAX_RATE_BPS=0
# Unconfirmed-by-owner orders expire after this many minutes (0 = never).
PENDING_ORDER_EXPIRY_MINUTES=120
# Customer may cancel while PENDING_ACCEPTANCE; after ACCEPTED only the owner can.
CUSTOMER_CAN_CANCEL_ACCEPTED=false
# Orders above this subtotal are flagged for manual review in the owner SMS.
LARGE_ORDER_THRESHOLD_CENTS=10000
CONFIRMATION_TOKEN_TTL_MINUTES=30
# Ask customers for a phone number before the summary.
REQUIRE_CUSTOMER_PHONE=true
# Text owners "did they pick it up?" this many minutes after pickup time (0 = never).
PICKUP_CHECK_AFTER_MINUTES=30
# Where owner alerts go: messenger (linked owner Facebook accounts, with a text to the owner phones
# as the backup when no owner can be reached on Messenger), both, or sms.
OWNER_ALERT_CHANNEL=messenger
# Store-local hour (0-23) to text owners the day's orders that were placed on an earlier day (-1 = off).
OWNER_REMINDER_HOUR=3
# A customer who writes again after this many quiet hours gets a fresh start: the AI only sees
# the new messages, and an unfinished cart is set aside until they say whether to keep it (0 = never).
SESSION_IDLE_HOURS=12

# --- Storage ---
DATABASE_PATH=./data/database.db
MENU_PATH=./data/menu.json
BUSINESS_PATH=./data/business.json
KNOWLEDGE_PATH=./data/knowledge/faq.json
QDRANT_URL=http://qdrant:6333
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=5

# --- Worker ---
WORKER_POLL_SECONDS=0.5
WORKER_MAX_ATTEMPTS=8
WORKER_CONCURRENCY=4
HISTORICAL_IMPORT_ENABLED=false
CLOUDFLARE_TUNNEL_TOKEN=

# --- Developer portal (http://127.0.0.1:8001/admin/) ---
# Values saved in the portal override the ones above. Credentials are stored encrypted with
# the key at MASTER_KEY_PATH (created on first run; back it up separately, never commit it).
BOT_MODE=paused
PUBLIC_BASE_URL=
MASTER_KEY_PATH=./data/keys/master.key
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8001
